{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ESNext",
            "DOM",
            "DOM.Iterable"
        ],
        "jsx": "preserve",
        "jsxImportSource": "vue",
        "paths": {
            "@/*": ["./assets/js/*"],
            "@/types": ["./assets/js/Types"],
            "@/types/*": ["./assets/js/Types/*"]
        },
        "types": [
            "vite/client"
        ],
        "resolveJsonModule": true,
        "allowJs": true,
        "sourceMap": true,
        "noEmit": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": [
        "assets/js/**/*.ts",
        "assets/js/**/*.d.ts",
        "assets/js/**/*.tsx", 
        "assets/js/**/*.vue"
    ]
}
