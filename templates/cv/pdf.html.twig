<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ cv.candidateName }} - {{ cv.position.title }} CV</title>
    <style>
        body { font-family: sans-serif; font-size: 14px; color: #333; line-height: 1.5; }
        .header-table { width: 100%; border-bottom: 2px solid #2563eb; padding-bottom: 15px; margin-bottom: 20px; border-collapse: collapse; }
        .header-left { width: 22%; text-align: left; vertical-align: middle; }
        .header-center { width: 56%; text-align: center; vertical-align: middle; }
        .header-right { width: 22%; text-align: right; vertical-align: middle; }
        .candidate-photo { width: 85px; height: 85px; border-radius: 8px; border: 1px solid #cbd5e1; }
        .header-center h1 { margin: 0; color: #1e3a8a; font-size: 24px; line-height: 1.2; }
        .header-center p { margin: 4px 0 0; font-size: 14px; color: #4b5563; }
        .header-center .location { font-size: 12px; color: #6b7280; margin-top: 2px; }
        .qr-code { width: 85px; height: 85px; }
        .qr-caption { font-size: 9px; color: #9ca3af; margin-top: 3px; }
        .section { margin-bottom: 25px; }
        .section h2 { border-bottom: 1px solid #d1d5db; padding-bottom: 5px; color: #1f2937; font-size: 18px; margin-bottom: 15px; }
        .grid { width: 100%; border-collapse: collapse; }
        .grid th { width: 30%; text-align: left; padding: 8px 0; color: #6b7280; font-weight: normal; vertical-align: top; }
        .grid td { width: 70%; padding: 8px 0; vertical-align: top; }
        .project { margin-bottom: 15px; }
        .project h3 { margin: 0 0 5px; font-size: 16px; color: #1f2937; }
        .project .period { font-size: 12px; color: #6b7280; margin-bottom: 8px; }
        .project .desc { margin-bottom: 5px; }
        .tags { font-size: 12px; color: #2563eb; }
        .empty { color: #ef4444; font-style: italic; }
    </style>
</head>
<body>
    <table class="header-table">
        <tr>
            <td class="header-left">
                {% if cv.candidatePhoto %}
                    <img class="candidate-photo" src="{{ cv.candidatePhoto }}" alt="Candidate Photo" />
                {% endif %}
            </td>
            <td class="header-center">
                <h1>{{ cv.candidateName }}</h1>
                <p>Applying for: <strong>{{ cv.position.title }}</strong></p>
                {% if cv.location %}
                    <p class="location">{{ cv.location }}</p>
                {% endif %}
            </td>
            <td class="header-right">
                <img class="qr-code" src="{{ qrCodeBase64 }}" alt="QR Code" />
                <div class="qr-caption">Scan to verify online</div>
            </td>
        </tr>
    </table>

    <div class="section">
        <h2>Professional Attributes</h2>
        <table class="grid">
            {% for attr in cv.position.attributes %}
                {% set val = null %}
                {% for cvAttr in cv.attributes %}
                    {% if cvAttr.attribute.id == attr.id %}
                        {% set val = cvAttr.value %}
                    {% endif %}
                {% endfor %}
                <tr>
                    <th>{{ attr.name }}</th>
                    <td>
                        {% if val is null or val == '' %}
                            <span class="empty">Not Provided</span>
                        {% else %}
                            {{ val }}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            {% if cv.position.attributes is empty %}
                <tr><td colspan="2">No specific attributes required for this position.</td></tr>
            {% endif %}
        </table>
    </div>

    <div class="section">
        <h2>Relevant Projects</h2>
        {% if cv.projects is empty %}
            <p>No projects included.</p>
        {% else %}
            {% for project in cv.projects %}
                <div class="project">
                    <h3>{{ project.name }}</h3>
                    <div class="period">
                        {% set start = project.dateStart ?? project.startDate %}
                        {% set end = project.dateEnd ?? project.endDate %}
                        {{ start ? start|date('M Y') : 'Start' }} - {{ end ? end|date('M Y') : 'Present' }}
                    </div>
                    <div class="desc">{{ project.description|nl2br }}</div>
                    {% if project.tags %}
                        <div class="tags">Tags: {{ project.tags|join(', ') }}</div>
                    {% endif %}
                </div>
            {% endfor %}
        {% endif %}
    </div>

    <div style="text-align: center; margin-top: 50px; font-size: 10px; color: #9ca3af;">
        Generated by CV Management System
    </div>
</body>
</html>
